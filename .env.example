# ============================================================
# CuratedVibe – Umgebungsvariablen
# Kopiere diese Datei als .env.local und befuelle alle Felder
# ============================================================

# ── Datenbank (Vercel Postgres / Supabase) ──────────────────
# Vercel Postgres: Im Vercel-Dashboard unter Storage -> Create Database
# Supabase: https://supabase.com/dashboard -> Settings -> Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── NextAuth ────────────────────────────────────────────────
# Generiere mit: openssl rand -base64 32
NEXTAUTH_SECRET="dein-super-geheimer-schluessel"
# Lokal: http://localhost:3000 | Produktion: https://deine-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── Spotify OAuth ───────────────────────────────────────────
# Erstelle eine App auf: https://developer.spotify.com/dashboard
# Redirect URI hinzufuegen: http://localhost:3000/api/auth/callback/spotify
# Fuer Produktion: https://deine-app.vercel.app/api/auth/callback/spotify
SPOTIFY_CLIENT_ID="dein-spotify-client-id"
SPOTIFY_CLIENT_SECRET="dein-spotify-client-secret"

# ── SoundCloud (optional) ───────────────────────────────────
# Registrierung: https://developers.soundcloud.com/
SOUNDCLOUD_CLIENT_ID="dein-soundcloud-client-id"

# ── Last.fm API (optional – fuer erweiterte Metadaten) ──────
# Erstelle einen Account: https://www.last.fm/api/account/create
LASTFM_API_KEY="dein-lastfm-api-key"

# ── App-Konfiguration ────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
